{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "llm-anthropic": {
      "name": "LLM, Anthropic API (DUDE_LLM_URL)",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "{env:DUDE_LLM_URL}",
        "apiKey": "{env:DUDE_LLM_KEY}"
      },
      "models": {
        "claude-opus-4.8": {"name": "Claude Opus 4.8", "reasoning": true, "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "claude-opus-5": {"name": "Claude Opus 5", "reasoning": true, "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "claude-sonnet-4.6": {"name": "Claude Sonnet 4.6", "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "claude-sonnet-5": {"name": "Claude Sonnet 5", "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "claude-sonnet-5-5": {"name": "Claude Sonnet 5.5", "reasoning": true, "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "claude-haiku-4.5": {"name": "Claude Haiku 4.5", "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 200000, "output": 64000}},
        "claude-fable-5-1": {"name": "Claude Fable 5.1", "reasoning": true, "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "claude-opus-5-5": {"name": "Claude Opus 5.5", "reasoning": true, "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}}
      }
    },
    "llm-openai": {
      "name": "LLM, OpenAI-compatible API (DUDE_LLM_URL)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:DUDE_LLM_URL}",
        "apiKey": "{env:DUDE_LLM_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {"name": "GPT 5.6 Sol", "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "gpt-5.6-terra": {"name": "GPT 5.6 Terra", "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 744000, "output": 128000}},
        "gpt-5.6-luna": {"name": "GPT 5.6 Luna", "attachment": true, "modalities": {"input": ["text", "image"], "output": ["text"]}, "limit": {"context": 40000, "output": 8000}}
      }
    }
  }
}

{
  "claude-sonnet-5 effort=": {
    "name": "implement wi_1",
    "labels": {
      "app": "dude",
      "dude.harness": "codex",
      "dude.model": "claude-sonnet-5",
      "dude.model_tier": "Coder",
      "dude.org": "org_1",
      "dude.phase": "implement",
      "dude.role": "implementer",
      "dude.run": "run_1",
      "dude.task": "wi_1"
    },
    "image": {
      "ref": "registry.example/dude/agent:1"
    },
    "workload": {
      "adapter": "codex",
      "command": [
        "codex",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "sandbox_mode=\"danger-full-access\"",
        "-c",
        "check_for_update_on_startup=false",
        "-c",
        "model=\"claude-sonnet-5\"",
        "-c",
        "model_provider=\"dude\"",
        "-c",
        "model_providers.dude={name=\"dude\", base_url=\"https://llm.example/v1\", env_key=\"OPENAI_API_KEY\", wire_api=\"responses\", http_headers={\"X-Team\"=\"dude\", \"anthropic-beta\"=\"context-1m\"}}",
        "-c",
        "model_reasoning_summary=\"detailed\"",
        "-c",
        "model_supports_reasoning_summaries=true",
        "-c",
        "web_search=\"live\"",
        "-c",
        "model_verbosity=\"low\""
      ],
      "prompt": "Do the thing.",
      "workdir": "/workspace",
      "mcpServers": [
        {
          "name": "dude",
          "service": "dude"
        }
      ],
      "services": [
        {
          "name": "dude",
          "url": "http://10.9.8.7:3120/mcp",
          "headers": [
            {
              "name": "Authorization",
              "secret": "DUDE_TOOLS_AUTH"
            }
          ],
          "loopback": true
        }
      ],
      "beforeStop": {
        "command": [
          "sh",
          "-c",
          "set -u\ndest=$1; shift\nbase_of() {\n  if first=$(git -C \"$1\" reflog show --format=%H \"refs/heads/$2\" -- 2\u003e/dev/null | tail -n 1) \u0026\u0026 [ -n \"$first\" ]; then\n    echo \"$first\"\n  else\n    git -C \"$1\" rev-parse -q --verify \"$2^{commit}\" 2\u003e/dev/null || git -C \"$1\" rev-parse -q --verify \"origin/$2^{commit}\"\n  fi\n}\nfold() {\n  dir=$1 start=$2; shift 2\n  at=$start label=$start\n  for g in \"$@\"; do\n    g=$(git -C \"$dir\" rev-parse -q --verify \"$g^{commit}\" 2\u003e/dev/null) || continue\n    git -C \"$dir\" merge-base --is-ancestor \"$g\" HEAD 2\u003e/dev/null || continue\n    git -C \"$dir\" merge-base --is-ancestor \"$g\" \"$at\" 2\u003e/dev/null \u0026\u0026 continue\n    if git -C \"$dir\" merge-base --is-ancestor \"$at\" \"$g\" 2\u003e/dev/null; then\n      at=$g\n    elif tree=$(git -C \"$dir\" merge-tree --write-tree \"$at\" \"$g\" 2\u003e/dev/null) \u0026\u0026\n      at=$(GIT_AUTHOR_NAME=dude GIT_AUTHOR_EMAIL=dude@localhost GIT_COMMITTER_NAME=dude GIT_COMMITTER_EMAIL=dude@localhost \\\n        git -C \"$dir\" commit-tree \"$tree\" -p \"$at\" -p \"$g\" -m given \u003c /dev/null 2\u003e/dev/null); then\n      :\n    else\n      echo \"$start $start\"; return\n    fi\n    label=$g\n  done\n  echo \"$label $at\"\n}\ndiffs() {\n  while [ $# -ge 3 ]; do\n    name=$1 dir=$2 ref=${3%% *}; given=${3#\"$ref\"}; shift 3\n    [ -d \"$dir\" ] || continue\n    base=$(base_of \"$dir\" \"$ref\") || continue\n    from=$(fold \"$dir\" \"$base\" $given)\n    echo \"# dude-diff $name ${from%% *}\"\n    idx=$(mktemp) || exit 3\n    real=$(git -C \"$dir\" rev-parse --git-path index)\n    case $real in /*) ;; *) real=$dir/$real ;; esac\n    if [ -f \"$real\" ]; then cp \"$real\" \"$idx\"; else rm -f \"$idx\"; fi\n    GIT_INDEX_FILE=$idx git -C \"$dir\" add -A -N . 2\u003e/dev/null\n    GIT_INDEX_FILE=$idx git -C \"$dir\" -c core.quotePath=off diff --no-color --no-ext-diff --find-renames \"${from#* }\" --\n    rm -f \"$idx\"\n  done\n}\nif [ \"$dest\" = - ]; then\n  diffs \"$@\" | head -c 8388608\nelif [ -n \"${LUX_ARTIFACTS:-}\" ]; then\n  out=$LUX_ARTIFACTS/.dude-final-diff\n  mkdir -p \"$out\" || exit 3\n  while [ $# -ge 3 ]; do\n    diffs \"$1\" \"$2\" \"$3\" | head -c 8388608 \u003e \"$out/.$1.tmp\" \u0026\u0026 mv \"$out/.$1.tmp\" \"$out/$1.patch\"\n    shift 3\n  done\nelse\n  tmp=$(mktemp -d) || exit 3\n  status=0\n  while [ $# -ge 3 ]; do\n    diffs \"$1\" \"$2\" \"$3\" | head -c 8388608 \u003e \"$tmp/$1.patch\" \u0026\u0026\n      /.lux/bin/lux-shim publish \"$tmp/$1.patch\" --name \".dude-final-diff/$1.patch\" \u003e /dev/null || status=3\n    shift 3\n  done\n  rm -rf \"$tmp\"\n  exit $status\nfi",
          "dude-diff",
          "artifacts",
          "api",
          "/workspace/repos/api",
          "main",
          "web",
          "/workspace/repos/web",
          "abc123"
        ],
        "timeout": "10s"
      }
    },
    "init": {
      "script": "manifest='/home/agent/.dude/setup'\n[ -f \"$manifest\" ] || exit 0\ncd '/workspace' || exit\ndude_setup() (\n\tcd \"$2\" || exit\n\tdone=$(git rev-parse --git-path dude-setup-done) \u0026\u0026 script=$(git rev-parse --git-path dude-setup.sh) || exit\n\t[ -e \"$done\" ] \u0026\u0026 exit 0\n\tprintf '%s%s\\n' 'dude: running the setup script of ' \"$1\" \u003e\u00262\n\tprintf '%s' \"$3\" | base64 -d \u003e \"$script\" || exit\n\tfor v in $(env | sed -n 's/=.*//p'); do\n\t\tcase \"$v\" in\n\t\t*[!A-Za-z0-9_]*) ;;\n\t\tGIT_CONFIG_KEY_* | GIT_CONFIG_VALUE_*) unset \"$v\" ;;\n\t\tesac\n\tdone\n\tunset GIT_CONFIG_PARAMETERS\n\texport GIT_CONFIG_COUNT=0\n\ttimeout -k 10s 900s bash -e \"$script\" \u003c /dev/null 3\u003c\u0026-\n\tcode=$?\n\trm -f \"$script\"\n\t[ \"$code\" -eq 0 ] || exit \"$code\"\n\t: \u003e \"$done\"\n)\nwhile IFS=' ' read -r name path script \u003c\u00263; do\n\tcase $name in '' | '#'*) continue ;; esac\n\tname=$(printf '%s' \"$name\" | base64 -d \u0026\u0026 echo .) \u0026\u0026 path=$(printf '%s' \"$path\" | base64 -d \u0026\u0026 echo .) ||\n\t\t{ echo \"dude: the setup manifest is unreadable\" \u003e\u00262; exit 1; }\n\tname=${name%.} path=${path%.}\n\tif [ ! -d \"$path\" ]; then\n\t\tprintf 'dude: %s has no checkout at %s; its setup script is skipped\\n' \"$name\" \"$path\" \u003e\u00262\n\t\tcontinue\n\tfi\n\tdude_setup \"$name\" \"$path\" \"$script\" || { code=$?; printf '%s%s %s\\n' 'dude-setup-failed: ' \"$code\" \"$name\" \u003e\u00262; exit \"$code\"; }\ndone 3\u003c \"$manifest\"\n"
    },
    "env": {
      "CLICOLOR_FORCE": "1",
      "FORCE_COLOR": "1",
      "GIT_CONFIG_COUNT": "2",
      "GIT_CONFIG_KEY_0": "color.ui",
      "GIT_CONFIG_KEY_1": "include.path",
      "GIT_CONFIG_VALUE_0": "always",
      "GIT_CONFIG_VALUE_1": "/usr/local/share/dude/git-config",
      "PY_COLORS": "1",
      "TERM": "xterm-256color"
    },
    "secrets": [
      {
        "name": "GIT_TOKEN",
        "value": "ghp_golden"
      },
      {
        "name": "dude-setup",
        "value": "# dude setup scripts: a repository a line, its name, checkout and script, each base64\n",
        "as": "file",
        "path": "/home/agent/.dude/setup"
      },
      {
        "name": "DUDE_TOOLS_AUTH",
        "value": "Bearer tok_golden"
      },
      {
        "name": "CODEX_CONFIG",
        "value": "approval_policy=\"never\"\nsandbox_mode=\"danger-full-access\"\ncheck_for_update_on_startup=false\nmodel=\"claude-sonnet-5\"\nmodel_provider=\"dude\"\nmodel_providers.dude={name=\"dude\", base_url=\"https://llm.example/v1\", env_key=\"OPENAI_API_KEY\", wire_api=\"responses\", http_headers={\"X-Team\"=\"dude\", \"anthropic-beta\"=\"context-1m\"}}\nmodel_reasoning_summary=\"detailed\"\nmodel_supports_reasoning_summaries=true\nweb_search=\"live\"\nmodel_verbosity=\"low\"\n",
        "as": "file",
        "path": "/home/agent/.codex/config.toml"
      },
      {
        "name": "OPENAI_API_KEY",
        "value": "sk-golden",
        "as": "env"
      }
    ],
    "git": {
      "repositories": [
        {
          "name": "api",
          "url": "https://github.com/acme/api.git",
          "ref": "main",
          "credential": "GIT_TOKEN",
          "path": "/workspace/repos/api"
        },
        {
          "name": "web",
          "url": "https://github.com/acme/web.git",
          "ref": "abc123",
          "credential": "GIT_TOKEN",
          "path": "/workspace/repos/web",
          "push": false
        }
      ],
      "push": {
        "branch": "dude/wi_1/run-run_1"
      }
    },
    "volumes": [
      {
        "name": "workspace",
        "path": "/workspace",
        "kind": "state"
      },
      {
        "name": "home",
        "path": "/home/agent",
        "kind": "state"
      }
    ],
    "timeout": "4h",
    "network": {
      "egress": [
        {
          "host": "llm.example"
        },
        {
          "cidr": "10.9.8.7/32"
        }
      ]
    }
  },
